  "hypotheses": [
    {
      "id": "event_day_balanced_binary_lgbm",
      "order": 1,
      "structure": "single binary booster with event-duration and normal station-layer-day balanced loss",
      "probability_rule": "mean_of_three_seed_probabilities",
      "fixed_weight_rule": "positive rows inverse-sqrt event length and normal rows inverse-sqrt station-layer KST-day size, each side mean-normalized, then positive side scaled by sqrt(Nneg/Npos)",
      "rationale": "reduce domination by long anomaly events and dense normal station-layer days while retaining calibrated binary detection"
    },
    {
      "id": "typed_multiclass_union_lgbm",
      "order": 2,
      "structure": "one six-class normal/spike/noise/flatline/offset/drift booster per seed",
      "probability_rule": "mean_of_three_seed_values_of_one_minus_P_normal",
      "fixed_target_rule": "first present type in spike,noise,flatline,offset,drift order; normal is class zero",
      "fixed_weight_rule": "inverse-square-root class-frequency weights normalized to mean one",
      "rationale": "separate anomaly mechanisms before union instead of forcing one binary partition"
    },
    {
      "id": "station_routed_binary_experts_lgbm",
      "order": 3,
      "structure": "one global fallback plus eligible station-specific binary experts per seed with deterministic station routing",
      "probability_rule": "route each row to its station expert only when that prefix has at least 5000 rows and both classes, otherwise use the global expert, then average three seed probabilities",
      "fixed_weight_rule": "sqrt within-station class ratio",
      "rationale": "allow distinct station observation regimes without post-hoc station thresholds"
    }
  ],

    "alpha_sweep": false,
    "seed_sweep": false,
    "architecture_search": false,
    "hyperparameter_search": false,
    "posthoc_subgroup_selection": false,
    "why_genuinely_distinct": "The signal is reconstructed from robust seasonal and cross-layer trajectory geometry before supervised fitting. It neither re-decodes the same unary probabilities as the semi-Markov experiments nor replaces the incumbent with a generic TCN/SSL model, and unlike the earlier four matched-filter features it uses a train-prefix baseline plus five fixed temporal scales and fail-closed station-layer guards."
  },

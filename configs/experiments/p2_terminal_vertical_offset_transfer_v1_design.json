    "calibration_mask": "target temp and psal jointly observed; public L1 and L5 temp finite; timestamp inside prefix",
    "offset_estimator": "unweighted median(target_temp-public_interpolation) independently by target layer",
    "prediction": "current_public_interpolation + frozen_layer_offset",
    "learned_parameters": "exactly three layer offsets per fold-prefix; deterministic median only",

  "group_balanced_celsius_objective": {
    "loss": "squared error in raw degrees Celsius",
    "group_hierarchy": [
      "target layer",
      "fixed historical training window",
      "KST calendar day",
      "eligible rows within that layer-window-day"
    ],
    "notation": {
      "L": "the three target layers {2,3,4}",
      "H": "the four fixed historical training windows",
      "D_lh": "nonempty KST days for target layer l in historical window h",
      "n_lhd": "eligible training rows for layer l, window h, and KST day d",
      "e_i": "raw-Celsius residual prediction error for training row i"
    },
    "objective": "R(f) = (1/3) * sum_l[(1/4) * sum_h[(1/|D_lh|) * sum_{d in D_lh}[(1/n_lhd) * sum_{i in l,h,d}(e_i^2)]]].",
    "equivalent_training_weight": "w_i = 1/(3 * 4 * |D_lh| * n_lhd) for row i in layer l, fixed window h, and KST day d; multiply all w_i by one common constant so the arithmetic mean is 1 before LightGBM.fit.",
    "empty_layer_window_policy": "FAIL_CLOSED_BEFORE_FIRST_FIT; do not drop, merge, or renormalize a fixed historical window.",
    "single_fixed_strength": "exact full hierarchical equalization; no interpolation with empirical row-frequency risk",
    "strength_rationale_not_selected_from_results": "The official metric gives each scored row equal Celsius squared-error influence, while training cadence and layer availability can make historical days and layers unequally represented. Full layer-window-day equalization is the sole structural counterfactual to NCR's inverse-profile-scale weighting and was fixed before NCR results were read.",
    "weight_may_not_use": [
      "residual magnitude",
      "profile_scale",
      "target positive or density ratio",
      "validation metric",
      "official leaderboard score",
      "official test rows or metadata"
    ]
  },

    "depth_weight": "(target_nominal_depth-layer1_nominal_depth)/(layer5_nominal_depth-layer1_nominal_depth)",
    "prediction": "target_temp_previous_calendar_year + (1-depth_weight)*(public_L1_temp_now-public_L1_temp_previous_calendar_year) + depth_weight*(public_L5_temp_now-public_L5_temp_previous_calendar_year)",
    "learned_parameters": 0,
    "stochastic_parameters": 0,
    "profile_projection": "apply the already pinned public-endpoint profile projection and CSV float roundtrip after the annual transfer",
    "fallback": "use the sealed Stage-A reference prediction byte-for-byte whenever the prior-year target/public endpoints are unavailable or the required prior-year timestamp lies outside the current eligible training prefix",
    "routing_inputs": [
      "calendar and prefix eligibility",
      "public layer 1 temperature",
      "public layer 5 temperature",
      "previous-year jointly observed target-layer temperature and salinity availability"
    ],

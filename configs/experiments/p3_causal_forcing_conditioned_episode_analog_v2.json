    "same_split_result_is_not_independent_confirmation": true,
    "v1_result": "NO_GO_B_NEAREST_NOT_BETTER_THAN_RANDOM",
    "v1_diagnostic_conclusion": "larger episode pools and smaller hs-DTW distances did not stabilize future residuals across station and regime",
    "interpretation_if_pass": "hypothesis-supporting adaptive inner evidence only; not an unbiased outer performance estimate",
    "interpretation_if_fail": "permanent stop for this exact v2 structure without threshold relaxation or rerun"
  },

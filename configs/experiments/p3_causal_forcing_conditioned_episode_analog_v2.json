    "metric": "six_lead_normalized_residual_mse_nearest_vs_random",
    "direction": "minimize",
    "single_structural_hypothesis": "Conditioning episode-distinct hs-DTW on a causal multivariate wind-wave forcing state resolves growth-versus-decay state aliasing that made v1 station- and regime-unstable.",
    "single_change_from_v1": "one_equal_weight_forcing_state_distance_term",
    "hyperparameter_search_count": 0,
    "threshold_search_count": 0,
    "model_fit_count_allowed": 0
  },

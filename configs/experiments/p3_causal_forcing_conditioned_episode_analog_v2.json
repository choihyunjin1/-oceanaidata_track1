  },
  "forcing_state": {
    "source": "frozen_causal_train_feature_cache_built_from_each_anchors_past_48h_only",
    "window_hours": 6,
    "columns_in_fixed_order": [
      "wind_input_proxy_mean_6h",
      "wind_input_proxy_slope_6h",
      "wind_wave_alignment_mean_6h",
      "gust_excess_mean_6h",
      "caph_slope_6h",
      "tp_slope_6h"
    ],
    "definitions_and_units": {
      "wind_input_proxy_mean_6h": {
        "definition": "mean(wspd^2 * max(cos(wdir-wvdir),0)) over finite past-context pairs",
        "unit": "m2_s-2"
      },
      "wind_input_proxy_slope_6h": {
        "definition": "ordinary-least-squares time slope of wspd^2 * max(cos(wdir-wvdir),0) over finite past-context pairs",
        "unit": "m2_s-2_per_hour"
      },
      "wind_wave_alignment_mean_6h": {
        "definition": "mean(cos(wdir-wvdir)) over finite past-context pairs; both directions are coming-from true-north clockwise degrees",
        "unit": "dimensionless"
      },
      "gust_excess_mean_6h": {
        "definition": "mean(gust-wspd) over finite past-context pairs",
        "unit": "m_s-1"
      },
      "caph_slope_6h": {
        "definition": "ordinary-least-squares time slope of local pressure over finite past-context values",
        "unit": "hPa_per_hour"
      },
      "tp_slope_6h": {
        "definition": "ordinary-least-squares time slope of mean wave period over finite past-context values",
        "unit": "seconds_per_hour"
      }
    },
    "causality": {
      "absolute_calendar_features": 0,
      "future_values": 0,
      "window_endpoint": "forecast_origin_inclusive",
      "statistics_fit_scope": "that_fold_that_station_inner_train_library_only"
    },
    "scaling": {
      "center": "componentwise_library_median_over_complete_rows",
      "scale": "componentwise_library_IQR_q75_minus_q25_over_complete_rows",
      "zero_or_nonfinite_IQR_fallback": 1.0,
      "unit_after_scaling": "dimensionless",
      "query_or_validation_statistics_used": false
    },
    "missing_fallback": {
      "candidate_row_with_any_nonfinite_state": "exclude_from_conditioned_index_only; retain in the v1 fallback and random-reference index",
      "query_with_any_nonfinite_state": "exact_v1_unconditioned_retrieval_and_projection",
      "complete_candidate_pool_with_fewer_than_8_distinct_episodes": "exact_v1_unconditioned_retrieval_and_projection",
      "imputation": "none"
    },
    "distance_and_selection": {
      "forcing_distance": "sqrt(mean((query_scaled-candidate_scaled)^2)) over exactly six fixed state components",
      "forcing_weight": 1.0,
      "combined_anchor_distance": "sqrt(hs_DTW_distance^2 + forcing_distance^2)",
      "admissible_search_bound": "sqrt(hs_LB_Keogh^2 + forcing_distance^2)",
      "episode_representative": "anchor_with_minimum_combined_distance_in_each_episode",
      "episode_rank": "ascending_combined_distance_then_episode_id_then_anchor_id",
      "selected_episode_count": 8,
      "projection_weight": "inverse_combined_distance",
      "search_batch_size": 1024
    }
  },

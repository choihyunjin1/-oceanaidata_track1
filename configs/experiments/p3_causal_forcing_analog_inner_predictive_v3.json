    },
    "C_gate": {
      "maximum_pooled_full_six_lead_delta_m": -0.005,
      "minimum_strictly_improved_folds": 2,
      "maximum_any_station_RMSE_degradation_m": 0.01,
      "lead_18_must_not_degrade": true,
      "lead_24_must_not_degrade": true,
      "pass_action": "stop_before_outer_and_await_separate_authorization",
      "failure_action": "permanent_stop_without_retuning_or_rerun"
    },
    "one_shot_no_rerun": true
  },

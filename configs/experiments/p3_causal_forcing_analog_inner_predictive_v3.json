{
  "schema_version": "1.0",
  "experiment_id": "p3_causal_forcing_analog_inner_predictive_v3",
  "status": "authorized_C_inner_only_one_shot",
  "objective": {
    "metric": "pooled_six_lead_RMSE_meters_candidate_vs_fixed_inner_control",
    "direction": "minimize",
    "single_question": "Does the sealed v2 forcing-conditioned analog improve the fixed 591-feature CatBoost inner control when blended only at 12/18/24h with alpha 0.2?",
    "model_or_feature_search_count": 0,
    "alpha_or_threshold_search_count": 0
  },
  "adaptive_research_disclosure": {
    "is_adaptive_research": true,
    "same_inner_split_reused_from_v1_and_v2": true,
    "independent_confirmation": false,
    "sealed_v2_B_decision": "PASS_B_ADAPTIVE_INNER_ONLY_STOP",
    "sealed_v2_B_conditioning_coverage": "19_of_57_B_eligible_cases",
    "sealed_v2_B_driver": "G-ORS forcing availability and winter-transition improvement",
    "known_instability": "2025_h1 v2 nearest MSE was 1.2032 percent worse than sealed v1",
    "interpretation_if_C_passes": "adaptive inner predictive evidence only; outer remains separately authorized and unopened",
    "interpretation_if_C_fails": "permanent stop for this exact candidate without retuning or rerun"
  },
  "sealed_v2_method": {
    "history_points": 145,
    "history_cadence_minutes": 20,
    "history_center": "current_hs",
    "history_scale": "raw_MAD_floor_0.1m",
    "minimum_history_coverage": 0.95,
    "same_station": true,
    "episode_distinct": true,
    "sakoe_chiba_radius_steps": 6,
    "neighbor_count": 8,
    "forcing_columns": [
      "wind_input_proxy_mean_6h",
      "wind_input_proxy_slope_6h",
      "wind_wave_alignment_mean_6h",
      "gust_excess_mean_6h",
      "caph_slope_6h",
      "tp_slope_6h"
    ],
    "forcing_scaling": "that_fold_that_station_complete_library_median_IQR",
    "combined_distance": "sqrt(hs_DTW_squared_plus_forcing_RMS_squared)",
    "missing_fallback": "exact_v1_unconditioned_retrieval",
    "projection": "inverse_distance_six_lead_normalized_residual",
    "distance_floor": 1e-6,
    "reproduction_contract": {
      "B_membership_keys_must_match": true,
      "neighbor_anchor_and_episode_hashes_must_match": true,
      "conditioning_and_fallback_must_match": true,
      "nearest_distance_summary_atol": 1e-12,
      "post_label_nearest_normalized_mse_atol": 1e-12
    }
  },
  "fixed_inner_control_proxy": {
    "purpose": "same_leakage_safe_frozen_like_control_used_by_v1_C_design",
    "limitation": "The full frozen multi-output/router model cannot be fitted honestly inside this nested split without a separate nested reproduction, so the preregistered single CatBoost proxy is used only for this C inner gate.",
    "base_feature_count": 591,
    "input_columns": ["station", "lead_h", "current_hs_for_residual", "frozen_591_features"],
    "target": "future_hs_minus_current_hs_residual",
    "family": "CatBoostRegressor",
    "iterations": 700,
    "learning_rate": 0.035,
    "depth": 6,
    "l2_leaf_reg": 8.0,
    "random_strength": 0.2,
    "random_seed": 20260817,
    "loss_function": "RMSE",
    "task_type": "CPU",
    "thread_count": 8,
    "allow_writing_files": false,
    "categorical_columns": ["station", "lead_h"],
    "sample_weight": "frozen_threshold_case_weights",
    "persistence_shrink_active_leads": [12, 18, 24],
    "persistence_shrink_weight": 0.2,
    "model_fit_count": 3
  },
  "candidate": {
    "evaluation_population": "all_61_same_inner_split_cases_x_6_leads_equals_366_rows",
    "v2_B_eligible_cases": 57,
    "history_ineligible_no_op_cases": 4,
    "no_op_leads": [3, 6, 9],
    "active_leads": [12, 18, 24],
    "alpha": 0.2,
    "formula": "candidate=control at 3/6/9; candidate=0.8*control+0.2*forcing_analog at 12/18/24 when analog applicable; otherwise exact control",
    "prediction_clip_m": [0.0, 30.0]
  },
  "validation": {
    "outer_windows_used_only_as_training_cutoffs": [
      ["2024_h2_storm", "2024-07-01", "2024-11-01"],
      ["winter_transition", "2024-11-01", "2025-03-01"],
      ["2025_h1", "2025-03-01", "2025-06-25"]
    ],
    "inner_validation_days": 45,
    "inner_case_spacing_hours": 78,
    "inner_episode_disjoint": true,
    "same_split_v2_membership_contract": "57_B_keys_must_match_and_4_history_ineligible_cases_are_candidate_no_op",
    "rolling_label_policy": {
      "current_fold_validation_labels_forbidden_in_that_fold_fit": true,
      "future_fold_validation_labels_forbidden_in_earlier_fold_fit": true,
      "prior_fold_validation_labels_allowed_as_later_chronological_history": true,

{
  "schema_version": "1.0",
  "experiment_id": "p3_causal_forcing_analog_outer_research_v4",
  "status": "implemented_dry_preflight_only_pending_QA_and_parent_authorization",
  "objective": {
    "metric": "pooled_six_lead_RMSE_meters_candidate_vs_exact_incumbent",
    "direction": "minimize",
    "single_hypothesis": "The sealed v2 forcing-conditioned, episode-distinct analog adds long-lead storm-evolution information to the exact frozen incumbent at fixed alpha 0.2.",
    "model_feature_alpha_threshold_search_count": 0
  },
  "adaptive_research_disclosure": {
    "is_adaptive_research": true,
    "outer_membership_and_labels_previously_inspected_in_prior_P3_research": true,
    "independent_holdout_claimed": false,
    "v2_B_and_v3_C_same_inner_split_reused": true,
    "v3_C_conditioning_coverage": "19_of_57_analog_eligible_cases",
    "v3_C_driver": "G-ORS-heavy forcing availability with a narrow 0.0009255m gate margin",
    "interpretation": "One-shot outer research evidence only; even a local pass cannot replace the frozen incumbent without a separately authorized official hidden-score comparison.",
    "promotion_without_hidden_score": false,
    "public_score_alone_is_not_sufficient_for_promotion": true
  },
  "sealed_method": {
    "history_points": 145,
    "history_cadence_minutes": 20,
    "history_hours": 48,
    "history_center": "current_hs",
    "history_scale": "raw_MAD_floor_0.1m",
    "minimum_history_coverage": 0.95,
    "same_station": true,
    "episode_distinct": true,
    "sakoe_chiba_radius_steps": 6,
    "sakoe_chiba_radius_hours": 2,
    "neighbor_count": 8,
    "forcing_columns": [
      "wind_input_proxy_mean_6h",
      "wind_input_proxy_slope_6h",
      "wind_wave_alignment_mean_6h",
      "gust_excess_mean_6h",
      "caph_slope_6h",
      "tp_slope_6h"
    ],
    "forcing_scaling": "that_fold_that_station_complete_library_median_IQR",
    "combined_distance": "sqrt(hs_DTW_squared_plus_forcing_RMS_squared)",
    "missing_forcing_fallback": "exact_v1_unconditioned_retrieval",
    "projection": "inverse_distance_six_lead_normalized_residual",
    "distance_floor": 1e-6
  },
  "outer_membership": {
    "source": "frozen_incumbent_OOF_key_columns_only",
    "allowed_pre_component_seal_columns": ["fold", "anchor_id", "station", "lead_h"],

    "base_row_weight_b_i": "Exactly the Round-B event/day weight: positive rows receive inverse-sqrt connected-event-length weight; normal rows receive inverse-sqrt station-layer KST-day-size weight; each side is mean-normalized; the positive side is then multiplied by sqrt(N_negative/N_positive).",
    "notation": {
      "I": "eligible rows in one outer training prefix",
      "G": "nonempty station x meteorological-season groups in that same prefix",
      "B": "sum over i in I of b_i",
      "B_g": "sum over rows i in group g of b_i",
      "ell_i": "binary log loss for row i"
    },
    "single_fixed_strength_lambda": 0.5,
    "objective": "R(f) = (1-lambda) * sum_i[b_i*ell_i]/B + lambda * (1/|G|) * sum_g(sum_{i in g}[b_i*ell_i]/B_g), with lambda=0.5.",
    "equivalent_training_weight": "w_i = b_i * ((1-lambda)/B + lambda/(|G|*B_g(i))); multiply all w_i by one common constant so their arithmetic mean is 1 before LightGBM.fit.",
    "optimization": "One ordinary LightGBM binary fit per registered fold-seed using the equivalent fixed row weights; no iterative GroupDRO, adversarial group-weight update, validation feedback, or second pass.",
    "strength_rationale_not_selected_from_results": "lambda=0.5 is the preregistered symmetric midpoint between the exact Round-B empirical risk and exact equal station-season group risk. It is a design prior chosen before predecessor results are read; there is no lambda grid, inner selection, or leaderboard selection.",

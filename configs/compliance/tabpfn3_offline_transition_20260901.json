{
  "schema_version": "ocean.tabpfn3.offline_transition.contract.v1",
  "model_name": "TabPFN-3",
  "model_version": "v3",
  "python_package": {"name": "tabpfn", "version": "8.5.0"},
  "organizer_policy": {
    "highest_precedence": true,
    "distributed_competition_data_only": true,
    "synthetic_only_pretrained_exception_used": true,
    "external_observation_reanalysis_forecast_rows": 0,
    "hidden_truth_rows": 0
  },
  "official_provenance": {
    "model_card": "https://huggingface.co/Prior-Labs/tabpfn_3",
    "technical_report": "https://arxiv.org/abs/2605.13986",
    "license_url": "https://huggingface.co/Prior-Labs/tabpfn_3/blob/main/LICENSE",
    "source_repository": "https://github.com/PriorLabs/TabPFN",
    "pretraining_character": "purely synthetic tabular tasks",
    "validated_frontiers": [
      {"max_samples": 1000000, "max_features": 200},
      {"max_samples": 100000, "max_features": 2000},
      {"max_samples": 1000, "max_features": 20000}
    ]
  },
  "license": {
    "user_must_accept_directly": true,
    "agent_may_not_accept_on_user_behalf": true,
    "platform": "https://platform.priorlabs.ai",
    "local_receipt_env": "TABPFN3_LICENSE_RECEIPT_PATH"
  },
  "weights": {
    "classifier": {
      "repository": "Prior-Labs/tabpfn_3",
      "revision": "24a16a89d245878b846555110985634aa2e656d7",
      "filename": "tabpfn-v3-classifier-v3_default.ckpt",
      "bytes": 212804803,
      "sha256": "d0d865d54dfbc524f5703104be90620182dca7e5fb2c16de72e9959ea18f3988",
      "path_env": "TABPFN3_CLASSIFIER_PATH"
    },
    "regressor": {
      "repository": "Prior-Labs/tabpfn_3",
      "revision": "24a16a89d245878b846555110985634aa2e656d7",
      "filename": "tabpfn-v3-regressor-v3_default.ckpt",
      "bytes": 233289807,
      "sha256": "311ce18d97e9533d8585eaadafe040fbdd8070533209ed8696641dadc97a7301",
      "path_env": "TABPFN3_REGRESSOR_PATH"
    },
    "bundled_for_reproduction": true,
    "local_offline_load_only": true,
    "automatic_download": false
  },
  "frozen_model_defaults": {
    "n_estimators": 8,
    "device": "cuda",
    "fit_mode": "fit_preprocessors",
    "memory_saving_mode": "auto",
    "ignore_pretraining_limits": false
  },
  "p1": {
    "features": 165,
    "grouping": "station_x_layer",
    "training_cap_per_model": 49000,
    "sampling": "keep_all_positive_then_sha256_rank_negative",
    "threshold": 0.5,
    "postprocess": "frozen_anchor_union",
    "screen": "Q2 pooled delta F1 > 0",
    "confirmation": "Q3 and Q4, no threshold tuning"
  },
  "p3": {
    "features": 591,
    "grouping": "six_lead_specific_residual_regressors",
    "target": "target_hs_minus_current_hs",
    "clean_fallback_weight": 0.75,
    "tabpfn_weight": 0.25,
    "promotion": "pooled RMSE strictly below clean fallback"
  },
  "prohibitions": [
    "official test read before historical confirmation",
    "sample submission read before explicit materialization approval",
    "automatic checkpoint download",
    "credential persistence",
    "external-data descendant use",
    "same-fold threshold or blend tuning",
    "result-based retry"
  ]
}
